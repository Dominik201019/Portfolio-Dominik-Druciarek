<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Dominik Druciarek</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,500;12..96,800&family=DM+Sans:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Układ: biała strona w stylu galerii, ogromna typografia, ciemne okienko z profilem w hero, pozioma karuzela projektów przypięta do scrolla, czarny finał z kontaktem */
:root {
  --paper: #ffffff;
  --ink: #0a0a0a;
  --mute: #6e6e73;
  --line: #e7e7ea;
  --soft: #f4f4f5;
  --night: #0c0c0e;
  --ok: #4ade80;
  --f-display: "Bricolage Grotesque", "Arial Narrow", Arial, sans-serif;
  --f-body: "DM Sans", "Segoe UI", Arial, sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, Consolas, monospace;
  color-scheme: light;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--paper); }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--f-body); font-size: 17px; line-height: 1.6; padding-left: 0; padding-right: 0; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--ink); color: var(--paper); }
.wrap { max-width: 1240px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }

#bar { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: var(--ink); transform: scaleX(0); transform-origin: 0 50%; z-index: 50; }
#dot { position: fixed; left: 0; top: 0; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: #fff; mix-blend-mode: difference; pointer-events: none; z-index: 60; transition: width .25s, height .25s, margin .25s; opacity: 0; }
#dot.big { width: 64px; height: 64px; margin: -32px 0 0 -32px; }
@media (hover: none) { #dot { display: none; } }

/* nav */
nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 40; background: rgba(255,255,255,.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
nav .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 14px; }
.logo { font-family: var(--f-display); font-weight: 800; font-size: 18px; letter-spacing: -.02em; display: flex; gap: 10px; align-items: center; }
.logo i { width: 10px; height: 10px; border-radius: 50%; background: var(--ink); position: relative; }
.logo i::after { content: ""; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--ink); animation: ping 2.4s infinite; }
.links { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
.links a { font-size: 14px; padding: 8px 14px; border-radius: 99px; transition: .25s; }
.links a:hover, .links a:focus-visible { background: var(--ink); color: var(--paper); outline: none; }

/* hero */
.hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 40px; align-items: center; padding-block: 72px 64px; }
.status { display: inline-flex; align-items: center; gap: 10px; font-family: var(--f-mono); font-size: 12px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 99px; background: var(--soft); }
.status i { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,.6); animation: live 2s infinite; }
h1 { font-family: var(--f-display); font-weight: 800; line-height: .9; letter-spacing: -.045em; font-size: clamp(54px, 11vw, 148px); margin: 28px 0 26px; }
h1 .ln { display: block; overflow: hidden; padding-bottom: .06em; }
h1 .ln span { display: inline-block; transform: translateY(105%); animation: up 1s cubic-bezier(.2,.8,.2,1) forwards; }
h1 .ln:nth-child(2) span { animation-delay: .12s; color: transparent; -webkit-text-stroke: 2px var(--ink); }
h1 .ln:nth-child(2):hover span { color: var(--ink); transition: color .3s; }
.lead { max-width: 46ch; font-size: clamp(17px, 2vw, 20px); color: #3a3a3f; font-weight: 300; margin: 0; }
.lead b { font-weight: 500; color: var(--ink); }
.cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
.btn { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 15px; padding: 16px 28px; border-radius: 99px; border: 1.5px solid var(--ink); cursor: pointer; font-family: inherit; position: relative; overflow: hidden; transition: color .35s, transform .25s; background: transparent; color: var(--ink); }
.btn::before { content: ""; position: absolute; inset: 0; background: var(--ink); transform: translateY(101%); transition: transform .4s cubic-bezier(.2,.8,.2,1); z-index: 0; }
.btn span { position: relative; z-index: 1; }
.btn:hover::before, .btn:focus-visible::before { transform: none; }
.btn:hover, .btn:focus-visible { color: var(--paper); transform: translateY(-2px); outline: none; }
.btn.solid { background: var(--ink); color: var(--paper); }
.btn.solid::before { background: var(--paper); }
.btn.solid:hover, .btn.solid:focus-visible { color: var(--ink); }

/* code window */
.win { background: var(--night); color: #d6d6da; border-radius: 16px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.45), 0 0 0 1px rgba(0,0,0,.9); overflow: hidden; transform: perspective(1100px) rotateY(-7deg) rotateX(3deg); transition: transform .5s; min-width: 0; }
.win:hover { transform: perspective(1100px) rotateY(0) rotateX(0); }
.win-top { display: flex; align-items: center; gap: 7px; padding: 14px 18px; border-bottom: 1px solid #1f1f24; }
.win-top i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
.win-top i:nth-child(2) { background: #febc2e; } .win-top i:nth-child(3) { background: #28c840; }
.win-top em { margin-left: auto; font-style: normal; font-family: var(--f-mono); font-size: 12px; color: #6d6d75; }
.win pre { margin: 0; padding: 22px 22px 26px; font-family: var(--f-mono); font-size: clamp(12px, 1.5vw, 14px); line-height: 1.85; min-height: 330px; white-space: pre-wrap; overflow-wrap: anywhere; }
.k { color: #fff; } .s { color: #86efac; } .c { color: #6d6d75; } .p { color: #a1a1aa; }
.caret { display: inline-block; width: 8px; height: 1.1em; background: #fff; vertical-align: -3px; animation: blink 1s steps(1) infinite; }

/* marquee */
.marq { background: var(--ink); color: var(--paper); overflow: hidden; border-block: 1px solid var(--ink); transform: rotate(-1.2deg); margin: 30px -2% 0; }
.marq-track { display: flex; width: max-content; animation: slide 30s linear infinite; padding-block: 20px; }
.marq-track span { font-family: var(--f-display); font-weight: 800; font-size: clamp(26px, 4.2vw, 52px); letter-spacing: -.02em; white-space: nowrap; padding-right: 40px; text-transform: uppercase; }
.marq-track span:nth-child(even) { color: transparent; -webkit-text-stroke: 1px var(--paper); }

/* sections */
section { padding-block: 120px 0; }
.eyebrow { font-family: var(--f-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); display: flex; gap: 12px; align-items: center; }
.eyebrow::before { content: ""; width: 32px; height: 1.5px; background: var(--ink); }
h2 { font-family: var(--f-display); font-weight: 800; letter-spacing: -.035em; line-height: .95; font-size: clamp(38px, 7vw, 92px); margin: 18px 0 0; text-wrap: balance; }

/* manifest: słowa ciemnieją przy scrollu */
.manifest { font-family: var(--f-display); font-weight: 500; letter-spacing: -.025em; line-height: 1.12; font-size: clamp(28px, 5vw, 62px); margin: 34px 0 0; max-width: 24ch; max-width: 30ch; }
.manifest .w { color: #d3d3d8; transition: color .25s; }
.manifest .w.on { color: var(--ink); }

/* usługi */
.rows { margin-top: 56px; border-top: 1.5px solid var(--ink); }
.row { display: grid; grid-template-columns: 70px minmax(0, 1.1fr) minmax(0, 1fr) 40px; gap: 24px; align-items: center; padding: 30px 12px; border-bottom: 1px solid var(--line); position: relative; transition: padding .35s, background .35s, color .35s; }
.row::before { content: ""; position: absolute; inset: 0; background: var(--ink); transform: scaleY(0); transform-origin: 50% 100%; transition: transform .4s cubic-bezier(.2,.8,.2,1); z-index: 0; }
.row > * { position: relative; z-index: 1; }
.row:hover::before { transform: scaleY(1); }
.row:hover { color: var(--paper); padding-left: 28px; padding-right: 28px; }
.row .no { font-family: var(--f-mono); font-size: 13px; color: var(--mute); transition: color .3s; }
.row:hover .no, .row:hover p { color: #b9b9c0; }
.row h3 { margin: 0; font-family: var(--f-display); font-weight: 800; letter-spacing: -.03em; font-size: clamp(26px, 3.6vw, 46px); line-height: 1; }
.row p { margin: 0; color: var(--mute); font-size: 16px; transition: color .3s; }
.row .arr { font-size: 26px; transition: transform .35s; justify-self: end; }
.row:hover .arr { transform: translateX(6px) rotate(-45deg); }

/* projekty: pozioma karuzela przypięta do scrolla */
.hs { height: 320vh; position: relative; margin-top: 40px; }
.hs-stick { position: sticky; top: calc(60px + env(safe-area-inset-top, 0px)); height: calc(100vh - 60px); display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
.hs-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; padding-bottom: 28px; }
.hs-head h2 { font-size: clamp(34px, 6vw, 80px); margin: 14px 0 0; }
.count { font-family: var(--f-mono); font-size: 13px; color: var(--mute); }
.count b { color: var(--ink); font-weight: 500; }
.hs-track { display: flex; gap: 28px; will-change: transform; padding-left: max(16px, calc((100vw - 1240px) / 2 + 16px)); padding-right: 16px; width: max-content; }
.pc { width: min(78vw, 560px); flex: none; }
.pc .shot { aspect-ratio: 4 / 3; border-radius: 18px; position: relative; overflow: hidden; display: grid; place-items: center; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
.pc:hover .shot { transform: scale(.975) rotate(-.6deg); }
.pc .meta { display: flex; justify-content: space-between; gap: 14px; align-items: baseline; padding: 18px 4px 0; }
.pc h3 { font-family: var(--f-display); font-weight: 800; font-size: 26px; letter-spacing: -.03em; margin: 0; }
.pc small { font-family: var(--f-mono); font-size: 12px; color: var(--mute); text-transform: uppercase; letter-spacing: .08em; }
.pc p { margin: 6px 4px 0; color: var(--mute); font-size: 15px; }
/* ilustracje projektów */
.a1 { background: var(--ink); }
.a1 .big { font-family: var(--f-display); font-weight: 800; font-size: clamp(46px, 9vw, 96px); letter-spacing: -.05em; color: var(--paper); line-height: .85; text-align: center; }
.a1 .big em { font-style: normal; color: transparent; -webkit-text-stroke: 1.5px var(--paper); display: block; }
.a2 { background: #ececee; }
.a2 .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; width: 78%; }
.a2 .tiles i { aspect-ratio: 3/4; border-radius: 10px; background: var(--ink); display: block; transition: transform .5s; }
.a2 .tiles i:nth-child(2) { background: #fff; border: 1.5px solid var(--ink); transform: translateY(-14px); }
.a2 .tiles i:nth-child(3) { background: #9a9aa2; }
.pc:hover .a2 .tiles i:nth-child(1) { transform: translateY(10px); }
.pc:hover .a2 .tiles i:nth-child(2) { transform: translateY(-26px); }
.pc:hover .a2 .tiles i:nth-child(3) { transform: translateY(10px); }
.a3 { background: #fff; border: 1.5px solid var(--ink); }
.a3 .circ { width: 56%; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid var(--ink); position: relative; display: grid; place-items: center; animation: rot 18s linear infinite; }
.a3 .circ::before { content: ""; position: absolute; inset: 14%; border-radius: 50%; border: 1.5px dashed var(--ink); }
.a3 .circ::after { content: ""; position: absolute; top: -7px; left: 50%; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); margin-left: -7px; }
.a3 .circ b { width: 30%; aspect-ratio: 1; border-radius: 50%; background: var(--ink); animation: rot 18s linear infinite reverse; }
.a4 { background: linear-gradient(135deg, #1a1a1d, #000); }
.a4 .lines { width: 70%; display: grid; gap: 14px; }
.a4 .lines i { height: 10px; border-radius: 9px; background: #fff; display: block; opacity: .9; }
.a4 .lines i:nth-child(2) { width: 72%; opacity: .5; } .a4 .lines i:nth-child(3) { width: 45%; opacity: .3; }
.a4 .lines u { width: 110px; height: 34px; border-radius: 99px; border: 1.5px solid #fff; display: block; margin-top: 10px; }
.hs-note { font-family: var(--f-mono); font-size: 12px; color: var(--mute); padding-top: 22px; }

/* proces */
.proc { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 56px; }
.st { position: relative; border: 1.5px solid var(--ink); border-radius: 18px; padding: 30px; min-width: 0; background: var(--paper); transition: transform .4s, background .4s, color .4s; overflow: hidden; }
.st:hover { background: var(--ink); color: var(--paper); transform: translateY(-8px); }
.st .n { font-family: var(--f-display); font-weight: 800; font-size: 76px; letter-spacing: -.05em; line-height: 1; }
.st h3 { font-family: var(--f-display); font-weight: 800; font-size: 24px; letter-spacing: -.02em; margin: 22px 0 8px; }
.st p { margin: 0; color: var(--mute); font-size: 15px; transition: color .4s; }
.st:hover p { color: #b9b9c0; }

/* liczby */
.nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; margin-top: 56px; border-block: 1px solid var(--line); }
.num { padding: 34px 20px; border-right: 1px solid var(--line); min-width: 0; }
.num:last-child { border-right: 0; }
.num b { display: block; font-family: var(--f-display); font-weight: 800; font-size: clamp(44px, 6vw, 80px); letter-spacing: -.05em; line-height: 1; font-variant-numeric: tabular-nums; }
.num span { color: var(--mute); font-size: 15px; }

/* kontakt */
.final { background: var(--ink); color: var(--paper); margin-top: 140px; border-radius: 28px 28px 0 0; padding-block: 90px 40px; position: relative; overflow: hidden; }
.final h2 { font-size: clamp(48px, 12vw, 180px); line-height: .88; max-width: 12ch; }
.final h2 em { font-style: normal; color: transparent; -webkit-text-stroke: 2px var(--paper); }
.final .lead { color: #b9b9c0; margin-top: 30px; }
.mailrow { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 34px; }
.mailrow code { font-family: var(--f-mono); font-size: clamp(15px, 3vw, 22px); padding: 15px 20px; border: 1px dashed #4a4a52; border-radius: 12px; overflow-wrap: anywhere; user-select: all; }
.final .btn { border-color: var(--paper); color: var(--paper); }
.final .btn::before { background: var(--paper); }
.final .btn:hover, .final .btn:focus-visible { color: var(--ink); }
.final .btn.solid { background: var(--paper); color: var(--ink); }
.final .btn.solid::before { background: var(--ink); }
.final .btn.solid:hover, .final .btn.solid:focus-visible { color: var(--paper); }
.foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 90px; padding-top: 24px; border-top: 1px solid #2a2a30; font-family: var(--f-mono); font-size: 12px; color: #8a8a93; }

.soc { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 80px; padding-top: 28px; border-top: 1px solid #2a2a30; }
.soc > span { font-family: var(--f-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #8a8a93; }
.soc-icons { display: flex; gap: 14px; }
.soc-icons a { width: 58px; height: 58px; border-radius: 50%; border: 1.5px solid var(--paper); display: grid; place-items: center; color: var(--paper); transition: background .3s, color .3s, transform .3s; }
.soc-icons a svg { width: 24px; height: 24px; }
.soc-icons a:hover, .soc-icons a:focus-visible { background: var(--paper); color: var(--ink); transform: translateY(-5px) rotate(-8deg); outline: none; }
.final .foot { margin-top: 28px; }

/* pojawianie przy scrollu */
.js .rv { opacity: 0; transform: translateY(40px); transition: opacity .9s cubic-bezier(.2,.8,.2,1), transform .9s cubic-bezier(.2,.8,.2,1); transition-delay: var(--d, 0s); }
.js .rv.in { opacity: 1; transform: none; }

@keyframes up { to { transform: none; } }
@keyframes blink { 50% { opacity: 0; } }
@keyframes slide { to { transform: translateX(-50%); } }
@keyframes ping { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(1.8); opacity: 0; } }
@keyframes live { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,.55); } 100% { box-shadow: 0 0 0 10px rgba(34,197,94,0); } }
@keyframes rot { to { transform: rotate(360deg); } }

@media (max-width: 900px) {
  .hero { grid-template-columns: minmax(0, 1fr); padding-top: 44px; }
  .win { transform: none; }
  .row { grid-template-columns: 44px minmax(0, 1fr) 28px; gap: 14px; padding: 24px 6px; }
  .row p { grid-column: 2 / 3; grid-row: 2; }
  .row .arr { grid-row: 1; grid-column: 3; }
  .hs { height: auto; }
  .hs-stick { position: static; height: auto; overflow: visible; }
  .hs-track { width: auto; display: grid; grid-template-columns: minmax(0, 1fr); padding: 0 max(16px, env(safe-area-inset-left, 0px)); gap: 40px; transform: none !important; }
  .pc { width: auto; }
  .count { display: none; }
  section { padding-top: 84px; }
  .num { border-right: 0; border-bottom: 1px solid var(--line); }
  .num:last-child { border-bottom: 0; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  h1 .ln span { transform: none; }
  .js .rv { opacity: 1; transform: none; }
  .marq-track { flex-wrap: wrap; width: auto; }
}
</style>

