<script>
(function () {
  document.documentElement.classList.add("js");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var $ = function (s) { return document.querySelector(s); };

  /* marquee */
  var words = ["Strony wizytówki", "Landing page", "Portfolio online", "Animacje", "Nowoczesny design", "Odświeżanie stron"], m = "";
  for (var r = 0; r < 4; r++) words.forEach(function (w) { m += "<span>" + w + " ✦</span>"; });
  $("#marq").innerHTML = m;

  /* okienko z profilem: pisanie */
  var lines = [
    [["const ", "k"], ["dominik", "k"], [" = {", "p"]],
    [["  imie", "k"], [": ", "p"], ["\"Dominik Druciarek\"", "s"], [",", "p"]],
    [["  zawod", "k"], [": ", "p"], ["\"Twórca stron internetowych\"", "s"], [",", "p"]],
    [["  pasja", "k"], [": ", "p"], ["\"Strony, które robią wrażenie\"", "s"], [",", "p"]],
    [["  oferta", "k"], [": [", "p"], ["\"Wizytówki\"", "s"], [", ", "p"], ["\"Landing page\"", "s"], [", ", "p"], ["\"Portfolio\"", "s"], [" ],", "p"]],
    [["  status", "k"], [": ", "p"], ["\"Przyjmuję zlecenia...\"", "s"]],
    [["}", "p"]]
  ];
  var code = $("#code");
  function esc(t) { return t.replace(/&/g, "&amp;").replace(/</g, "&lt;"); }
  function render(upto) {
    var out = "", n = 0, done = true;
    for (var i = 0; i < lines.length; i++) {
      for (var j = 0; j < lines[i].length; j++) {
        var t = lines[i][j][0], c = lines[i][j][1], left = upto - n;
        if (left <= 0) { done = false; break; }
        var piece = t.slice(0, left); n += t.length;
        if (piece.length < t.length) done = false;
        out += "<span class=\"" + c + "\">" + esc(piece) + "</span>";
      }
      if (upto - n < 0 || !done) break;
      if (i < lines.length - 1) out += "\n";
    }
    code.innerHTML = out + (done && upto > 0 ? "" : "") + "<span class=\"caret\"></span>";
  }
  var total = lines.reduce(function (a, l) { return a + l.reduce(function (b, s) { return b + s[0].length; }, 0); }, 0);
  if (reduce) { render(total); } else {
    var k = 0;
    setTimeout(function tick() { render(k); k += 2; if (k <= total + 2) setTimeout(tick, 22); }, 900);
  }

  /* pasek postępu + karuzela + manifest */
  var bar = $("#bar"), hs = $("#hs"), track = $("#track"), cur = $("#cur");
  var mf = $("#manifest"), txt = mf.textContent.trim().split(/\s+/);
  mf.innerHTML = txt.map(function (w) { return "<span class=\"w\">" + w + "</span>"; }).join(" ");
  var ws = mf.querySelectorAll(".w");
  var ticking = false;
  function onScroll() {
    var h = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = "scaleX(" + (h > 0 ? Math.min(1, scrollY / h) : 0) + ")";
    /* manifest */
    var b = mf.getBoundingClientRect();
    var p = Math.min(1, Math.max(0, (innerHeight * .85 - b.top) / (b.height + innerHeight * .35)));
    var lit = Math.round(p * ws.length);
    for (var i = 0; i < ws.length; i++) ws[i].classList.toggle("on", i < lit);
    /* pozioma karuzela */
    if (innerWidth > 900 && !reduce) {
      var r = hs.getBoundingClientRect(), span = hs.offsetHeight - innerHeight;
      var q = Math.min(1, Math.max(0, -r.top / span));
      var maxX = Math.max(0, track.scrollWidth - innerWidth);
      track.style.transform = "translateX(" + (-q * maxX) + "px)";
      cur.textContent = "0" + (Math.min(4, Math.floor(q * 4 + .0001) + 1));
    } else { track.style.transform = ""; }
    ticking = false;
  }
  window.addEventListener("scroll", function () { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  /* pojawianie elementów */
  var els = document.querySelectorAll(".rv");
  if ("IntersectionObserver" in window && !reduce) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { threshold: .12, rootMargin: "0px 0px -6% 0px" });
    els.forEach(function (e) { io.observe(e); });
  } else { els.forEach(function (e) { e.classList.add("in"); }); }

  /* liczniki */
  var cio = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      cio.unobserve(e.target);
      var el = e.target, n = +el.dataset.n, s = el.dataset.s || "", t0 = null;
      if (reduce) { el.textContent = n + s; return; }
      requestAnimationFrame(function f(t) {
        if (!t0) t0 = t;
        var p = Math.min(1, (t - t0) / 1600), v = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(v * n) + s;
        if (p < 1) requestAnimationFrame(f);
      });
    });
  }, { threshold: .6 });
  document.querySelectorAll("[data-n]").forEach(function (e) { cio.observe(e); });

  /* kursor */
  var dot = $("#dot");
  window.addEventListener("pointermove", function (e) {
    if (e.pointerType === "touch") return;
    dot.style.opacity = 1; dot.style.transform = "translate(" + e.clientX + "px," + e.clientY + "px)";
  });
  document.querySelectorAll("a, button, .pc, .st").forEach(function (a) {
    a.addEventListener("pointerenter", function () { dot.classList.add("big"); });
    a.addEventListener("pointerleave", function () { dot.classList.remove("big"); });
  });

  /* ikony social: puste linki nie przeskakują na górę strony */
  document.querySelectorAll('.soc-icons a[href="#"]').forEach(function (a) {
    a.addEventListener("click", function (e) { e.preventDefault(); });
  });

  /* kopiowanie */
  var btn = $("#copy"), mail = $("#mail"), lab = btn.querySelector("span");
  function sel() { var r = document.createRange(); r.selectNodeContents(mail); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
  btn.addEventListener("click", function () {
    try {
      navigator.clipboard.writeText(mail.textContent).then(function () {
        lab.textContent = "Skopiowano"; setTimeout(function () { lab.textContent = "Kopiuj adres"; }, 1800);
      }, sel);
    } catch (e) { sel(); }
  });
})();
</script>

